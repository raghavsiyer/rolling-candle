<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The candle's Quantower-free maths and its gradient brush; the view and the indicator need Quantower, so
         they stay out. The brush is drawn onto a bitmap with System.Drawing, from the Windows Desktop runtime. -->
    <Compile Include="..\src\RollingCandle.cs" LinkBase="src" />
    <Compile Include="..\src\CandleShade.cs" LinkBase="src" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
</Project>
